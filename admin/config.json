{
  "backend": {
    "name": "github",
    "repo": "reonica/avecjo",
    "branch": "main",
    "auth_scope": "public_repo",
    "open_authoring": true,
    "auth_endpoint": "admin/auth",
    "squash_merges": true
  },
  "publish_mode": "editorial_workflow",
  "site_url": "https://www.guidehanoi.com",
  "display_url": "https://www.guidehanoi.com",
  "logo_url": "/assets/images/logo-avec-jo-25741c9ba0.png",
  "media_folder": "assets/images",
  "public_folder": "/assets/images",
  "collections": [
    {
      "name": "posts",
      "label": "Bài blog",
      "label_singular": "Bài viết",
      "description": "Soạn bài bằng tiếng Pháp. Lưu nháp và chuyển sang Ready to review để gửi chủ repo duyệt.",
      "folder": "content/posts",
      "format": "json",
      "extension": "json",
      "identifier_field": "slug",
      "slug": "{{fields.slug}}",
      "summary": "{{title}}",
      "create": true,
      "delete": false,
      "sortable_fields": ["title", "date", "dateModified"],
      "fields": [
        {"label":"Đường dẫn bài (không đổi sau khi xuất bản)","name":"slug","widget":"string","hint":"Ví dụ: visiter-hanoi-en-famille. Chỉ chữ thường, số và dấu gạch ngang.","pattern":["^[a-z0-9]+(?:-[a-z0-9]+)*$","Chỉ dùng chữ thường, số và dấu gạch ngang."]},
        {"label":"Tiêu đề bài","name":"title","widget":"string"},
        {"label":"Tiêu đề SEO","name":"seoTitle","widget":"string","hint":"Tiêu đề hiển thị trên Google và khi chia sẻ."},
        {"label":"Mô tả SEO","name":"description","widget":"text","hint":"Tóm tắt riêng cho bài, khoảng 140–170 ký tự."},
        {"label":"Ảnh đại diện","name":"image","widget":"image","allow_multiple":false,"choose_url":false,"media_library":{"config":{"max_file_size":5242880}}},
        {"label":"Mô tả ảnh (alt)","name":"imageAlt","widget":"string"},
        {"label":"Chuyên mục","name":"category","widget":"select","options":[{"label":"Lịch trình Việt Nam","value":"circuits-vietnam"},{"label":"Điểm đến nổi bật","value":"incontournables-vietnam"},{"label":"Kinh nghiệm du lịch","value":"conseils-voyage"}]},
        {"label":"Chủ đề / tags","name":"tags","widget":"list","required":false,"default":[]},
        {"label":"Ngày đăng","name":"date","widget":"datetime","default":"{{now}}","picker_utc":true},
        {"label":"Ngày cập nhật","name":"dateModified","widget":"datetime","required":false,"default":""},
        {"label":"Nội dung bài","name":"html","widget":"avecjo-html","hint":"Soạn nội dung, chèn ảnh, bảng và liên kết. Upload ảnh trong Media trước; dùng đường dẫn /assets/images/ten-anh.jpg khi chèn ảnh."}
      ]
    }
  ]
}
